{
  "expo": {
    "name": "PodsNow",
    "slug": "podsnow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "podsnow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.nemotea.podsnow",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PodsNow uses the microphone to record your podcast.",
        "UIBackgroundModes": ["audio"]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "dev.nemotea.podsnow",
      "adaptiveIcon": {
        "backgroundColor": "#D8F36A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D9DCDE",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 240,
          "android": {
            "imageWidth": 176
          },
          "dark": {
            "backgroundColor": "#2B2F32",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ja", "en"],
          "supportsRTL": false
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope-Regular.ttf",
              "./assets/fonts/Manrope-Medium.ttf",
              "./assets/fonts/Manrope-SemiBold.ttf",
              "./assets/fonts/Manrope-Bold.ttf",
              "./assets/fonts/NotoSansJP-Regular.ttf",
              "./assets/fonts/NotoSansJP-Medium.ttf",
              "./assets/fonts/NotoSansJP-SemiBold.ttf",
              "./assets/fonts/NotoSansJP-Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Noto Sans JP",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/NotoSansJP-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/NotoSansJP-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/NotoSansJP-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/NotoSansJP-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#D9DCDE",
      "dark": {
        "backgroundColor": "#2B2F32"
      }
    },
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    }
  }
}
